{
  "framework": "astro",
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ],
  "redirects": [
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/project.html", "has": [{ "type": "query", "key": "p", "value": "branding-1" }], "destination": "/branding/aura-bare/", "permanent": true },
    { "source": "/project.html", "has": [{ "type": "query", "key": "p", "value": "branding-2" }], "destination": "/branding/bibi/", "permanent": true },
    { "source": "/project.html", "destination": "/", "permanent": false }
  ]
}
