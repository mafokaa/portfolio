---
import { Image } from 'astro:assets';
import type { Project } from '../data/projects';
import Ctr from './Ctr.astro';

interface Props { project: Project; }
const { cards } = Astro.props.project.data;
---
<article>
  <div class="grid">
    {cards.map(c => (
      <div class="card" data-reveal>
        <div class="frame slider" data-slider>
          <div class="track" data-track>
            {(c.slides.length ? c.slides : [null]).map(s => (
              <div class="slide frame">{s && <Image src={s} alt="" widths={[400, 600, 900]} sizes="(min-width: 900px) 33vw, 100vw" />}</div>
            ))}
          </div>
          {c.slides.length > 1 && (
            <div class="ui">
              <span class="count"><span data-idx>1</span> / {c.slides.length}</span>
              <div class="btns">
                <button type="button" data-prev aria-label="Предыдущий слайд">←</button>
                <button type="button" data-next aria-label="Следующий слайд">→</button>
              </div>
            </div>
          )}
        </div>
        <Ctr before={c.before} after={c.after} />
      </div>
    ))}
  </div>
</article>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 260px), 1fr)); gap: clamp(12px, 1.6vw, 24px); }
  .card { display: flex; flex-direction: column; gap: 16px; }
  .slider { width: 100%; aspect-ratio: 3 / 4; border-radius: 14px; }
  .track { position: absolute; inset: 0; display: flex; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; overscroll-behavior-x: contain; }
  .track::-webkit-scrollbar { display: none; }
  .slide { flex: 0 0 100%; height: 100%; scroll-snap-align: start; background: none; }
  .ui { position: absolute; left: 12px; right: 12px; bottom: 12px; display: flex; justify-content: space-between; align-items: center; pointer-events: none; }
  .count { padding: 5px 11px; border-radius: 999px; background: #fff; color: #161616; font-size: 13px; font-weight: 500; font-variant-numeric: tabular-nums lining-nums; }
  .btns { display: flex; gap: 6px; pointer-events: auto; }
  button { width: 38px; height: 38px; border: 0; border-radius: 50%; background: #fff; color: #161616; font: inherit; font-size: 15px; cursor: pointer; box-shadow: 0 2px 10px rgba(0, 0, 0, .12); }
  button:hover { background: var(--accent); color: #fff; }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-slider]').forEach(sl => {
    const tr = sl.querySelector<HTMLElement>('[data-track]')!;
    const idx = sl.querySelector('[data-idx]');
    sl.querySelector('[data-prev]')?.addEventListener('click', () => tr.scrollBy({ left: -tr.clientWidth, behavior: 'smooth' }));
    sl.querySelector('[data-next]')?.addEventListener('click', () => {
      const end = tr.scrollLeft + tr.clientWidth >= tr.scrollWidth - 4;
      tr.scrollTo({ left: end ? 0 : tr.scrollLeft + tr.clientWidth, behavior: 'smooth' });
    });
    if (idx) tr.addEventListener('scroll', () => { idx.textContent = String(Math.round(tr.scrollLeft / tr.clientWidth) + 1); }, { passive: true });
  });
</script>
