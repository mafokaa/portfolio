---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import { site } from '../data/site';
---
<Base title={`Страница не найдена — ${site.name}`}>
  <Nav />
  <main>
    <h1 class="display">Такой страницы нет</h1>
    <a class="pill" href="/">На главную →</a>
  </main>
</Base>

<style>
  main { min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 32px; padding: 0 var(--gutter); text-align: center; }
  h1 { margin: 0; font-size: clamp(40px, 7vw, 110px); line-height: 1.02; text-wrap: balance; }
</style>
